# Copy this file to .env and fill in the keys.

# Location checker: OpenRouteService routes and Geoapify places
ORS_API_KEY=
GEOAPIFY_API_KEY=

# Web search checker: Google Custom Search JSON API (Google stops it on 1 January 2027)
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=

# Optional settings (defaults shown)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# MAX_CONCURRENCY=2
# REVIEWS_DIR=Hotel Reviews with claims
