# Copy this file to .env and fill in the keys.

# Location checker: OpenRouteService routes and Geoapify places
ORS_API_KEY=
GEOAPIFY_API_KEY=

# Web search checker: SerpApi, for Google web and image results (free plan: 250 searches a month)
SERPAPI_API_KEY=

# Optional settings (defaults shown)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# MAX_CONCURRENCY=2
# REVIEWS_DIR=data/reviews_with_claims
# RESULTS_DIR=results
# NOMINATIM_USER_AGENT=MultiAgentFakeReviewsDetection/1.0 (+https://github.com/habibst1/Multi-Agent-Fake-Reviews-Detection)
